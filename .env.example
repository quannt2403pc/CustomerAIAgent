# ============================================================
# .env.example — SAO CHÉP thành .env rồi điền giá trị thật.
# File .env đã bị .gitignore chặn. KHÔNG đặt secret thật vào file này.
# ============================================================

# --- Database ---------------------------------------------------------------
# Trong Docker: host là tên service `db`. Chạy thủ công: đổi thành localhost.
DATABASE_URL=postgresql+psycopg://appuser:change-me@db:5432/customeraiagent
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=customeraiagent

# --- Mã hoá at-rest (Fernet) ------------------------------------------------
# SINH-NGAU-NHIEN: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=SINH-NGAU-NHIEN

# --- Cổng model A: CLIProxy / Antigravity (OAuth Google) --------------------
CLIPROXY_BASE_URL=http://cliproxy:8317
# SINH-NGAU-NHIEN: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Phải TRÙNG với remote-management.secret-key trong cliproxy/config.yaml
CLIPROXY_MGMT_KEY=SINH-NGAU-NHIEN
CLIPROXY_AUTH_PROVIDER=antigravity

# --- Cổng model B: Google API Key trực tiếp ---------------------------------
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com
# Để RỖNG nếu nhập key qua UI (được mã hoá rồi lưu DB). Chỉ điền khi chạy CLI
# thuần mà không muốn dùng DB.
GOOGLE_API_KEY=

# --- Lựa chọn cổng / model (rỗng = chưa chọn, UI sẽ buộc chọn) --------------
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0.9
LLM_MAX_OUTPUT_TOKENS=4096

# --- Ứng dụng ---------------------------------------------------------------
DOCS_ENABLED=false
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

# --- Luật thép ---------------------------------------------------------------
# L3: hệ thống chỉ soạn nháp, không gửi tin cho người thật. Giữ nguyên true.
DRY_RUN=true

# --- Collector --------------------------------------------------------------
PLAYWRIGHT_ENABLED=false

# Cookie Facebook của CHÍNH BẠN (tuỳ chọn, task X.2).
#
# Vì sao cần: bài viết **Công khai** vẫn bị che với khách chưa đăng nhập — đo
# đối chứng ở task.md I-33. Không có cookie thì chỉ lấy được tên + ảnh.
#
# RỦI RO: Facebook có thể gắn cờ hoặc khoá tài khoản bị dùng để truy cập tự
# động. Cân nhắc dùng tài khoản phụ của chính bạn. KHÔNG dùng tài khoản người
# khác (luật L3).
#
# Lấy: DevTools → Network → một request tới facebook.com → copy header `Cookie`.
# Đường khuyến nghị là nhập qua trang Cài đặt (mã hoá Fernet rồi lưu DB);
# biến này chỉ dành cho chạy CLI thuần.
FACEBOOK_COOKIE=
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MIN_INTERVAL_SECONDS=1.0
RUN_MIGRATIONS=1

# --- Facebook Page / Messenger Platform (task.md X.6) ---
# Gửi/nhận tự động CHỈ qua một Facebook Page, và CHỈ tới người đã chủ động nhắn
# Page trước. Xem hướng dẫn 7 bước trong UI: Cài đặt → Kết nối Facebook Page.
#
# App Secret — dùng kiểm X-Hub-Signature-256 của webhook. Thiếu nó thì KHÔNG xác
# thực được tin đến, và hệ thống từ chối mọi webhook (đúng như vậy: chấp nhận tin
# không xác thực được còn tệ hơn là từ chối).
MESSENGER_APP_SECRET=
# Chuỗi bạn TỰ ĐẶT, dài và khó đoán. Facebook gửi lại ở bước verify webhook.
MESSENGER_VERIFY_TOKEN=
